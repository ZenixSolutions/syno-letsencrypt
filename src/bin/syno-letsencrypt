#!/usr/bin/env bash
#
# syno-letsencrypt — Let's Encrypt certificates for Synology DSM, over the
# Cloudflare DNS-01 challenge, installed straight into DSM.
#
# Subcommands:
#   check    Validate the Cloudflare token and DSM access. Changes nothing.
#   issue    Obtain a certificate and install it into DSM.
#   renew    Renew if within the window; install only if it actually changed.
#   status   Show configuration, expiry, and when the next run is due.
#
# Runs as root. Installed by install.sh; the DSM scheduled task calls `renew`.
#
set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly SELF_DIR
readonly LIB_DIR="${SYNOLE_LIB_DIR:-${SELF_DIR}/../share/syno-letsencrypt/lib}"

# shellcheck source=../lib/log.sh
. "${LIB_DIR}/log.sh"
# shellcheck source=../lib/cloudflare.sh
. "${LIB_DIR}/cloudflare.sh"
# shellcheck source=../lib/dsm.sh
. "${LIB_DIR}/dsm.sh"
# shellcheck source=../lib/schedule.sh
. "${LIB_DIR}/schedule.sh"
# shellcheck source=../lib/dns.sh
. "${LIB_DIR}/dns.sh"
# shellcheck source=../lib/ui.sh
. "${LIB_DIR}/ui.sh"

# One place to undo anything that alters the terminal or leaves files behind.
# Ctrl-C during the DNS wait would otherwise leave the cursor hidden.
_TMPFILES=()
_cleanup() {
    ui_cursor_restore
    [ ${#_TMPFILES[@]} -eq 0 ] || rm -f "${_TMPFILES[@]}"
}
trap _cleanup EXIT INT TERM

readonly CONFIG_DIR="${SYNOLE_CONFIG_DIR:-/usr/local/etc/syno-letsencrypt}"
readonly CONFIG="${CONFIG_DIR}/config"
readonly LEGO_DATA="${CONFIG_DIR}/lego"
readonly LEGO_BIN="${SYNOLE_LEGO_BIN:-/usr/local/bin/lego}"
readonly STATE="${CONFIG_DIR}/last-install"

# Defaults; the config file overrides them.
CLOUDFLARE_DNS_API_TOKEN=""
DOMAINS=""
ACME_EMAIL=""
STAGING="false"
SET_DEFAULT="true"
RENEW_DAYS="30"
DNS_RESOLVERS="1.1.1.1:53 8.8.8.8:53"

# How long to wait for the challenge record to become visible on Cloudflare's
# nameservers. Set explicitly rather than left to lego's default so the
# progress display can show a real deadline instead of a guess.
PROPAGATION_TIMEOUT="180"

# Whether lego confirms the challenge record itself before asking Let's
# Encrypt to validate.
#
#   wait   (default) lego creates the record, sleeps PROPAGATION_WAIT seconds,
#          and hands over. Let's Encrypt then performs the validation that
#          actually decides the outcome, from its own resolvers.
#   check  lego polls the authoritative nameservers until it sees the record.
#          Cheaper on failure -- a record that never appears costs a local
#          timeout rather than one of Let's Encrypt's five failed validations
#          per hostname per hour.
#
# Why wait is the default
# -----------------------
# lego's check is a rehearsal of what Let's Encrypt will do, and it is the
# rehearsal that fails on a resolver holding a stale negative answer. Measured
# on a real NAS: lego created the record and queried it two seconds later,
# before Cloudflare was serving it. The resulting NXDOMAIN was cached for the
# zone's SOA minimum of 1800 seconds, so every subsequent poll returned the
# same stale answer and the challenge could never pass -- while the record was
# live and visible to the entire rest of the internet, including Let's Encrypt.
#
# Not querying at all avoids creating that cached negative in the first place.
# Let's Encrypt asks for the name for the first time, from resolvers that have
# no reason to hold anything stale about it.
PROPAGATION_MODE="wait"
PROPAGATION_WAIT="120"


# How DSM labels this certificate in Control Panel. Renewals match on it, so
# they replace the existing entry rather than adding a new one every 60 days.
DEFAULT_CERT_DESC="Let's Encrypt (syno-letsencrypt)"
CERT_DESC="${DEFAULT_CERT_DESC}"
CERT_MODE="replace"
CERT_REPLACE_ID=""
readonly SERVICES_FILE="${CONFIG_DIR}/services.json"

load_config() {
    [ -r "${CONFIG}" ] || die "Not configured. Run the installer first: sudo ./install.sh"
    # shellcheck disable=SC1090
    . "${CONFIG}"
    [ -n "${DOMAINS}" ]                  || die "No domains set in ${CONFIG}"
    [ -n "${CLOUDFLARE_DNS_API_TOKEN}" ] || die "No Cloudflare token set in ${CONFIG}"
}

# primary_domain — first entry in DOMAINS, wildcard prefix stripped. This is
# what the zone is looked up by, and what lego names the certificate files after.
primary_domain() {
    local first="${DOMAINS%%,*}"
    first="${first# }"; first="${first% }"
    printf '%s' "${first#\*.}"
}

# --------------------------------------------------------------------------
cmd_check() {
    load_config
    local failed=0

    log_info "Domains:     ${DOMAINS}"
    log_info "Environment: $([ "${STAGING}" = "true" ] && echo 'STAGING (test certificates)' || echo production)"
    log_info ""

    cf_check_token "${CLOUDFLARE_DNS_API_TOKEN}" "$(primary_domain)" >/dev/null || failed=1
    log_info ""

    log_info "Checking whether this NAS can see public DNS..."
    local zone dns_rc=0
    zone="$(primary_domain)"
    dns_check_public_visible "${zone}" || dns_rc=$?
    case "${dns_rc}" in
        0) log_info "Port-53 answers match the public view." ;;
        1) log_warn "Port-53 answers do NOT match the public view of this domain."
           dns_describe_view "${zone}" >&2
           log_warn "Local propagation checks will be skipped; Let's Encrypt validates"
           log_warn "from outside, where the record is visible." ;;
        *) log_warn "Could not compare local DNS against the public view."
           dns_describe_view "${zone}" >&2 ;;
    esac
    log_info ""

    log_info "Checking DSM access..."
    if dsm_preflight 2>/dev/null; then
        log_info "Running as root, and DSM's certificate API is reachable."
    else
        log_error "Cannot reach DSM's certificate API. Are you running as root?"
        failed=1
    fi

    log_info ""
    if [ "${failed}" -eq 0 ]; then
        log_info "All checks passed."
    else
        log_error "Checks failed."
    fi
    return "${failed}"
}

# --------------------------------------------------------------------------
run_lego() {
    local action="$1"; shift
    local -a domain_args=() lego_args=()
    local d r _domains

    IFS=',' read -ra _domains <<<"${DOMAINS}"
    for d in "${_domains[@]}"; do
        d="${d# }"; d="${d% }"
        [ -n "${d}" ] && domain_args+=(--domains "${d}")
    done

    lego_args=(
        --accept-tos
        --email "${ACME_EMAIL}"
        --dns cloudflare
        --path "${LEGO_DATA}"
        "${domain_args[@]}"
    )

    [ "${STAGING}" = "true" ] \
        && lego_args+=(--server https://acme-staging-v02.api.letsencrypt.org/directory)

    # lego replaces its recursive nameserver list entirely with these; it does
    # not consult /etc/resolv.conf. Note this is not sufficient on a network
    # that intercepts port 53 — naming a public resolver does not help when the
    # destination address is not what is honoured.
    for r in ${DNS_RESOLVERS}; do
        lego_args+=(--dns.resolvers "${r}")
    done

    # No auto-detection. It was tried, and it compared nameserver lists -- which
    # match perfectly on exactly the network where this fails, so it chose the
    # broken mode. The signal that matters is not observable before the record
    # exists.
    local mode="${PROPAGATION_MODE}"
    if [ "${mode}" = "wait" ]; then
        lego_args+=(--dns.propagation-wait "${PROPAGATION_WAIT}s")
        log_info "Creating the DNS record, then waiting ${PROPAGATION_WAIT}s before"
        log_info "Let's Encrypt validates it. The certificate is still fully verified;"
        log_info "only lego's own local pre-check is skipped."
    fi

    mkdir -p "${LEGO_DATA}"
    chmod 700 "${LEGO_DATA}"

    log_info "lego ${action}: ${DOMAINS}"

    # Non-interactive (the scheduled task, or output redirected): let lego
    # write straight through, so the task history and any log capture keep the
    # full detail.
    if [ "${UI_TTY}" != true ]; then
        CLOUDFLARE_DNS_API_TOKEN="${CLOUDFLARE_DNS_API_TOKEN}" \
        CLOUDFLARE_PROPAGATION_TIMEOUT="${PROPAGATION_TIMEOUT}" \
            "${LEGO_BIN}" "${lego_args[@]}" "${action}" "$@"
        return $?
    fi

    # Interactive: lego prints one identical line every two seconds while it
    # waits for DNS to propagate — up to ninety of them, none of which say how
    # far along it is. Capture the output, show progress against the real
    # deadline, and print the log only if something fails.
    local log rc
    log="$(mktemp)"; _TMPFILES+=("${log}")
    CLOUDFLARE_DNS_API_TOKEN="${CLOUDFLARE_DNS_API_TOKEN}" \
    CLOUDFLARE_PROPAGATION_TIMEOUT="${PROPAGATION_TIMEOUT}" \
        "${LEGO_BIN}" "${lego_args[@]}" "${action}" "$@" >"${log}" 2>&1 &

    local deadline="${PROPAGATION_TIMEOUT}"
    [ "${mode}" = "wait" ] && deadline="${PROPAGATION_WAIT}"
    ui_progress $! "${log}" "${deadline}"
    rc=$?

    if [ "${rc}" -ne 0 ]; then
        log_error "lego failed. Full output:"
        sed 's/^/    /' "${log}" >&2
    else
        # Keep the parts worth seeing; drop the propagation spam.
        grep -E "Server responded with a certificate|acme: Registering|Obtaining" "${log}" \
            | sed 's/^/    /' || true
    fi
    return "${rc}"
}

# cert_paths — prints "<cert> <key> <chain>".
cert_paths() {
    local name base
    name="$(primary_domain)"
    base="${LEGO_DATA}/certificates/${name}"
    # lego renames a certificate whose first SAN is a wildcard.
    [ -f "${base}.crt" ] || base="${LEGO_DATA}/certificates/_.${name}"
    printf '%s %s %s' "${base}.crt" "${base}.key" "${base}.issuer.crt"
}

install_into_dsm() {
    local cert key chain leaf target new_id
    read -r cert key chain <<<"$(cert_paths)"
    [ -f "${cert}" ] || die "No certificate at ${cert}"

    # lego writes cert.crt as leaf + chain. DSM wants the leaf on its own, so
    # give it just the first certificate rather than a bundle.
    leaf="$(mktemp)"; _TMPFILES+=("${leaf}")
    openssl x509 -in "${cert}" -out "${leaf}"

    # Decide what we are updating. Order matters:
    #   1. a certificate we previously created, found by description — this is
    #      the renewal path, and replacing keeps every service assignment;
    #   2. the certificate the user chose to replace at install time;
    #   3. nothing, meaning create a new entry.
    target="$(dsm_find_cert_id "${CERT_DESC}")"
    if [ -z "${target}" ] && [ "${CERT_MODE}" = "replace" ]; then
        target="${CERT_REPLACE_ID}"
    fi

    new_id="$(dsm_import_cert "${leaf}" "${key}" "${chain}" \
                "${CERT_DESC}" "${SET_DEFAULT}" "${target}")"

    # Replacing preserves services automatically. A new entry does not, and
    # as_default only moves the system default -- FTPS, Drive, VPN and friends
    # stay on the old certificate until explicitly reassigned.
    if [ -z "${target}" ] && [ -s "${SERVICES_FILE}" ] && [ -n "${new_id}" ]; then
        dsm_assign_services "${new_id}" "$(cat "${SERVICES_FILE}")" || true
    fi

    date -u '+%Y-%m-%dT%H:%M:%SZ' > "${STATE}"
}

cmd_issue() {
    load_config
    dsm_require_root issue
    run_lego run
    install_into_dsm
    log_info "Done."
}

cmd_renew() {
    load_config
    dsm_require_root renew

    local cert before after
    read -r cert _ _ <<<"$(cert_paths)"

    if [ ! -f "${cert}" ]; then
        log_info "No certificate yet; issuing for the first time."
        run_lego run
        install_into_dsm
        return
    fi

    before="$(sha256sum "${cert}" | cut -d' ' -f1)"
    run_lego renew --days "${RENEW_DAYS}"
    read -r cert _ _ <<<"$(cert_paths)"
    after="$(sha256sum "${cert}" | cut -d' ' -f1)"

    # lego exits 0 whether or not it renewed anything, so compare content.
    # Re-importing an unchanged certificate would restart DSM's web server
    # every single day for no reason.
    if [ "${before}" = "${after}" ]; then
        log_info "Certificate is still current; nothing to do."
        return 0
    fi

    log_info "Certificate was renewed; installing into DSM."
    install_into_dsm
}

# --------------------------------------------------------------------------
cmd_status() {
    load_config
    local cert
    read -r cert _ _ <<<"$(cert_paths)"

    printf 'Domains:      %s\n' "${DOMAINS}"
    printf 'Environment:  %s\n' "$([ "${STAGING}" = "true" ] && echo 'staging (test certificates)' || echo production)"
    printf 'Config:       %s\n' "${CONFIG}"

    if [ ! -f "${cert}" ]; then
        printf 'Certificate:  not yet issued\n'
        return 1
    fi

    printf 'Subject:      %s\n' "$(openssl x509 -in "${cert}" -noout -subject | cut -d= -f2-)"
    printf 'Expires:      %s\n' "$(openssl x509 -in "${cert}" -noout -enddate | cut -d= -f2)"
    if openssl x509 -in "${cert}" -noout -checkend $(( RENEW_DAYS * 86400 )) >/dev/null 2>&1; then
        printf 'Renewal:      not due yet\n'
    else
        printf 'Renewal:      due\n'
    fi

    [ -f "${STATE}" ] && printf 'Last install: %s\n' "$(cat "${STATE}")"

    sched_status || true

    local target
    target="$(dsm_find_cert_id "${CERT_DESC}")"
    if [ -n "${target}" ]; then
        printf 'In DSM:       %s serving %s service(s)\n' \
            "${target}" "$(dsm_cert_services "${target}" | jq 'length')"
    else
        printf 'In DSM:       not found under "%s"\n' "${CERT_DESC}"
    fi
    return 0
}

usage() { sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

main() {
    local cmd="${1:-}"
    [ $# -gt 0 ] && shift
    command -v jq >/dev/null 2>&1 || die "jq is required but not on PATH."
    case "${cmd}" in
        check)  cmd_check "$@" ;;
        issue)  cmd_issue "$@" ;;
        renew)  cmd_renew "$@" ;;
        status) cmd_status "$@" ;;
        -h|--help|help|'') usage ;;
        *) die "Unknown command: ${cmd}. Try --help." ;;
    esac
}

main "$@"
