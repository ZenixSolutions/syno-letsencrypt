#!/usr/bin/env bash
#
# syno-letsencrypt — Let's Encrypt certificates for Synology DSM, issued over
# the Cloudflare DNS-01 challenge and installed through DSM's own Web API.
#
# Subcommands:
#   check    Validate configuration, Cloudflare token and DSM login. Changes nothing.
#   issue    Obtain a certificate and install it into DSM.
#   renew    Renew if within the window, install only if it actually changed.
#   status   Show configuration and certificate expiry.
#
set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SELF_DIR
readonly LIB_DIR="${SELF_DIR}/../lib"

# shellcheck source=../lib/log.sh
. "${LIB_DIR}/log.sh"
# shellcheck source=../lib/cloudflare.sh
. "${LIB_DIR}/cloudflare.sh"
# shellcheck source=../lib/dsm-api.sh
. "${LIB_DIR}/dsm-api.sh"

# --------------------------------------------------------------------------
# Configuration — all environment, because this runs as a container.
# --------------------------------------------------------------------------
DATA="${SYNOLE_DATA:-/data}"
readonly LEGO_DATA="${DATA}/lego"
readonly STATE="${DATA}/state"

# Declared here so the linter and the reader both know these come from the
# container environment, and so an unset one fails loudly rather than silently.
CLOUDFLARE_DNS_API_TOKEN="${CLOUDFLARE_DNS_API_TOKEN:-}"
DSM_URL="${DSM_URL:-}"
DSM_USERNAME="${DSM_USERNAME:-}"
DSM_PASSWORD="${DSM_PASSWORD:-}"

DOMAINS="${DOMAINS:-}"
ACME_EMAIL="${ACME_EMAIL:-}"
STAGING="${STAGING:-false}"
SET_DEFAULT="${SET_DEFAULT:-true}"
RENEW_DAYS="${RENEW_DAYS:-30}"

# How DSM identifies this certificate. Renewals match on it so they replace the
# existing entry rather than adding one every 60 days. Configurable in case a
# NAS runs more than one instance.
# Kept in its own variable: an apostrophe inside ${VAR:-default} is legal but
# reads as an unterminated quote to both humans and linters.
DEFAULT_CERT_DESC="Let's Encrypt (syno-letsencrypt)"
CERT_DESC="${CERT_DESC:-${DEFAULT_CERT_DESC}}"

# primary_domain — first entry in DOMAINS, wildcard prefix stripped.
primary_domain() {
    local first="${DOMAINS%%,*}"
    first="${first# }"; first="${first% }"
    printf '%s' "${first#\*.}"
}

# --------------------------------------------------------------------------
# check
# --------------------------------------------------------------------------
cmd_check() {
    local failed=0

    log_info "--- Configuration ---"
    log_info "Domains:     ${DOMAINS}"
    log_info "ACME email:  ${ACME_EMAIL}"
    log_info "Environment: $([ "${STAGING}" = "true" ] && echo 'STAGING (test certificates)' || echo production)"
    log_info "DSM:         ${DSM_URL:-<unset>} as ${DSM_USERNAME:-<unset>}"
    log_info ""

    log_info "--- Cloudflare ---"
    cf_check_token "${CLOUDFLARE_DNS_API_TOKEN}" "$(primary_domain)" >/dev/null || failed=1
    log_info ""

    log_info "--- DSM ---"
    if dsm_login; then
        # Listing certificates is the cheapest call that proves the account is
        # genuinely an administrator — the usual misconfiguration.
        dsm_find_cert_id "${CERT_DESC}" >/dev/null \
            && log_info "DSM account can manage certificates."
        dsm_logout
    else
        failed=1
    fi

    log_info ""
    if [ "${failed}" -eq 0 ]; then
        log_info "All checks passed."
    else
        log_error "One or more checks failed."
    fi
    return "${failed}"
}

# --------------------------------------------------------------------------
# issue / renew
# --------------------------------------------------------------------------
run_lego() {
    local action="$1"; shift
    local -a domain_args=() lego_args=()
    local d r _domains

    IFS=',' read -ra _domains <<<"${DOMAINS}"
    for d in "${_domains[@]}"; do
        d="${d# }"; d="${d% }"
        [ -n "${d}" ] && domain_args+=(--domains "${d}")
    done

    lego_args=(
        --accept-tos
        --email "${ACME_EMAIL}"
        --dns cloudflare
        --path "${LEGO_DATA}"
        "${domain_args[@]}"
    )

    [ "${STAGING}" = "true" ] \
        && lego_args+=(--server https://acme-staging-v02.api.letsencrypt.org/directory)

    # lego finds a domain's zone apex with SOA queries against the system
    # resolver. On a network running Pi-hole, AdGuard or split-horizon DNS that
    # walk fails, and the error it produces reads like a credentials problem.
    # Pinning public resolvers for the challenge lookup removes the whole class.
    for r in ${DNS_RESOLVERS:-1.1.1.1:53 8.8.8.8:53}; do
        lego_args+=(--dns.resolvers "${r}")
    done

    mkdir -p "${LEGO_DATA}"
    log_info "lego ${action}: ${DOMAINS}"
    CLOUDFLARE_DNS_API_TOKEN="${CLOUDFLARE_DNS_API_TOKEN}" lego "${lego_args[@]}" "${action}" "$@"
}

# cert_paths — prints "<cert> <key> <chain>".
cert_paths() {
    local name base
    name="$(primary_domain)"
    base="${LEGO_DATA}/certificates/${name}"
    # lego renames a certificate whose first SAN is a wildcard.
    [ -f "${base}.crt" ] || base="${LEGO_DATA}/certificates/_.${name}"
    printf '%s %s %s' "${base}.crt" "${base}.key" "${base}.issuer.crt"
}

install_into_dsm() {
    local cert key chain leaf
    read -r cert key chain <<<"$(cert_paths)"
    [ -f "${cert}" ] || die "No certificate at ${cert}"

    # lego writes cert.crt as leaf + chain. DSM wants the leaf alone, so hand it
    # just the first certificate rather than a bundle.
    leaf="$(mktemp)"
    # shellcheck disable=SC2064  # expand now, deliberately
    trap "rm -f '${leaf}'" EXIT
    openssl x509 -in "${cert}" -out "${leaf}"

    dsm_login || return 1
    dsm_import_cert "${leaf}" "${key}" "${chain}" "${CERT_DESC}" "${SET_DEFAULT}"
    dsm_logout
}

cmd_issue() {
    run_lego run
    install_into_dsm
    mkdir -p "${STATE}"
    date -u '+%Y-%m-%dT%H:%M:%SZ' > "${STATE}/last-install"
    log_info "Certificate issued and installed."
}

cmd_renew() {
    local cert before after
    read -r cert _ _ <<<"$(cert_paths)"

    if [ ! -f "${cert}" ]; then
        log_info "No certificate yet; issuing for the first time."
        cmd_issue
        return
    fi

    before="$(sha256sum "${cert}" | cut -d' ' -f1)"
    run_lego renew --days "${RENEW_DAYS}"
    read -r cert _ _ <<<"$(cert_paths)"
    after="$(sha256sum "${cert}" | cut -d' ' -f1)"

    # lego exits 0 whether or not it renewed, so compare content. Re-importing
    # an unchanged certificate would restart DSM's web server daily for nothing.
    if [ "${before}" = "${after}" ]; then
        log_info "Certificate is still current; nothing to do."
        return 0
    fi

    log_info "Certificate was renewed; installing into DSM."
    install_into_dsm
    mkdir -p "${STATE}"
    date -u '+%Y-%m-%dT%H:%M:%SZ' > "${STATE}/last-install"
}

# --------------------------------------------------------------------------
cmd_status() {
    local cert
    read -r cert _ _ <<<"$(cert_paths)"

    printf 'Domains:      %s\n' "${DOMAINS}"
    printf 'Environment:  %s\n' "$([ "${STAGING}" = "true" ] && echo staging || echo production)"
    printf 'DSM:          %s\n' "${DSM_URL:-<unset>}"

    if [ ! -f "${cert}" ]; then
        printf 'Certificate:  not yet issued\n'
        return 1
    fi

    printf 'Certificate:  %s\n' "${cert}"
    printf 'Subject:      %s\n' "$(openssl x509 -in "${cert}" -noout -subject | cut -d= -f2-)"
    printf 'Expires:      %s\n' "$(openssl x509 -in "${cert}" -noout -enddate | cut -d= -f2)"
    if openssl x509 -in "${cert}" -noout -checkend $(( RENEW_DAYS * 86400 )) >/dev/null 2>&1; then
        printf 'Renewal:      not due\n'
    else
        printf 'Renewal:      due\n'
    fi

    [ -f "${STATE}/last-install" ] \
        && printf 'Last install: %s\n' "$(cat "${STATE}/last-install")"
    return 0
}

usage() { sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

main() {
    local cmd="${1:-}"
    [ $# -gt 0 ] && shift
    case "${cmd}" in
        check)  cmd_check "$@" ;;
        issue)  cmd_issue "$@" ;;
        renew)  cmd_renew "$@" ;;
        status) cmd_status "$@" ;;
        -h|--help|help|'') usage ;;
        *) die "Unknown command: ${cmd}" ;;
    esac
}

main "$@"
