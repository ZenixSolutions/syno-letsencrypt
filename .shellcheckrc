# Allow sourcing files that shellcheck cannot resolve statically.
external-sources=true
# SPK control scripts are /bin/sh; library code is bash. Per-file shells are
# declared with shebangs, so let shellcheck infer rather than forcing one.
enable=add-default-case,avoid-nullary-conditions,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-variable-braces

# src/bin/* source siblings under src/lib at runtime; give shellcheck the path
# so `-x` can follow them instead of emitting SC1091.
source-path=src/lib
