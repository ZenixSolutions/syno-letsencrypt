[Unit]
Description=Daily Let's Encrypt renewal check
Documentation=https://github.com/ZenixSolutions/syno-letsencrypt

[Timer]
OnCalendar=daily
# Spread load across the Let's Encrypt fleet and avoid every NAS on earth
# hitting the ACME endpoint at midnight.
RandomizedDelaySec=6h
# Catch up if the NAS was powered off when the timer should have fired.
Persistent=true

[Install]
WantedBy=timers.target
