#!/bin/sh
# SYNOPKG_* and wizard_* variables are exported into this script's
# environment by the DSM package framework, not assigned here.
# shellcheck disable=SC2154
# Runs as root. Honours the uninstall wizard choice.
#
# The certificate already installed in DSM is intentionally left in place —
# removing this package should not take DSM's web UI down to a self-signed
# certificate.
set -eu

PKGVAR="/var/packages/${SYNOPKG_PKGNAME}/var"
TARGET="${SYNOPKG_PKGDEST:-}"

if [ "${wizard_delete_data:-false}" = "true" ]; then
    echo "Removing configuration and revoking the Cloudflare token."
    if [ -n "${TARGET}" ] && [ -x "${TARGET}/bin/syno-letsencrypt" ]; then
        "${TARGET}/bin/syno-letsencrypt" revoke-token || \
            echo "Could not revoke the Cloudflare token; delete it manually in the Cloudflare dashboard." >&2
    fi
    rm -rf "${PKGVAR}" "/var/packages/${SYNOPKG_PKGNAME}/home"
else
    echo "Keeping configuration and certificates for a future reinstall."
fi
exit 0
