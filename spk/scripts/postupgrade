#!/bin/sh
# SYNOPKG_* and wizard_* variables are exported into this script's
# environment by the DSM package framework, not assigned here.
# shellcheck disable=SC2154
# Runs as root. Re-enable the timer in case unit files changed.
set -eu
if command -v synosystemctl >/dev/null 2>&1; then
    synosystemctl enable "pkg-${SYNOPKG_PKGNAME}-renew.timer" || true
    synosystemctl start  "pkg-${SYNOPKG_PKGNAME}-renew.timer" || true
fi
exit 0
