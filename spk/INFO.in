package="syno-letsencrypt"
displayname="Let's Encrypt (Cloudflare DNS)"
version="@VERSION@"
os_min_ver="7.0-40000"
arch="@ARCH@"
description="Issues and automatically renews Let's Encrypt certificates (including wildcards) using the Cloudflare DNS-01 challenge, and installs them into DSM. No inbound ports need to be open."
maintainer="Zenix Solutions"
maintainer_url="https://github.com/ZenixSolutions/syno-letsencrypt"
distributor="Zenix Solutions"
distributor_url="https://github.com/ZenixSolutions/syno-letsencrypt"
support_url="https://github.com/ZenixSolutions/syno-letsencrypt/issues"
helpurl="https://github.com/ZenixSolutions/syno-letsencrypt#readme"
changelog="@CHANGELOG@"
checksum="@CHECKSUM@"
ctl_stop="no"
startable="no"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="no"
